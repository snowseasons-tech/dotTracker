# Keep this file private. Do not commit .env.production.
DATABASE_URL=postgresql://dottracker_app:REPLACE_PASSWORD@db.example.net:5432/dottracker?sslmode=require
MIGRATION_DATABASE_URL=postgresql://dottracker_migrator:REPLACE_PASSWORD@db.example.net:5432/dottracker?sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=15
DEVICE_TOKEN=not-used-in-production
# Base map: OpenFreeMap by default. Use "offline" for the built-in map that needs no outside
# network, or an https:// style URL from your own tile server. List any other https:// origins
# the style loads tiles, glyphs or sprites from in MAP_EXTRA_ORIGINS (comma-separated).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
MAP_EXTRA_ORIGINS=
