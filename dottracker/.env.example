# Local development only. Never reuse these credentials outside an isolated demo.
APP_ENV=development
DATABASE_URL=postgresql://dottracker:dottracker_dev@db:5432/dottracker
JWT_SECRET=local-only-change-this-secret-32-chars
ACCESS_TOKEN_MINUTES=30
DEVICE_TOKEN=demo-device-token
ALLOW_DEMO_SEED=true
# Base map: OpenFreeMap by default; "offline" uses the built-in map with no outside network.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
